DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
ANALYTICS_HASH_SALT=
GEOIP_DATABASE_PATH=

# Production email (used when DJANGO_DEBUG=False)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Admin bootstrap (production-only, idempotent)
# These are used by: python manage.py bootstrap_admin
# ADMIN_PASSWORD must be supplied through Render Environment Variables.
# Existing admin passwords are never overwritten.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
